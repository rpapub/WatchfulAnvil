<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net8.0</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<Version>0.1.0</Version>
		<FileVersion>0.1.0.0</FileVersion>
		<AssemblyVersion>0.1.0.0</AssemblyVersion>
		<InformationalVersion>0.1.0</InformationalVersion>
		<Authors>Christian Prior-Mamulyan</Authors>
		<Company>cprima.net</Company>
		<PackageDescription>Custom UiPath Workflow Analyzer rules by Christian Prior-Mamulyan — Library project edition.</PackageDescription>

		<!-- Opt in to the shared build logic: per-TFM UiPath.Activities.Api version
		     and the net461 language block. See build/WatchfulAnvil.Build/. -->
		<WatchfulAnvilRulePack>true</WatchfulAnvilRulePack>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\WatchfulAnvil.Sdk\WatchfulAnvil.Sdk.csproj">
			<PrivateAssets>all</PrivateAssets>
		</ProjectReference>
	</ItemGroup>

	<!-- ILRepack: merge WatchfulAnvil.Sdk.dll into Cpmf.Rules.Libs.dll (single self-contained assembly) -->
	<ItemGroup>
		<PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- Remove any stale DLLs from previous assembly names so ILRepack doesn't pick them up -->
	<Target Name="CleanStaleAssemblies" BeforeTargets="ILRepack" Condition="'$(TargetFramework)' != ''">
		<ItemGroup>
			<StaleAssembly Include="$(TargetDir)*.dll"
				Exclude="$(TargetDir)$(AssemblyName).dll;$(TargetDir)WatchfulAnvil.Sdk.dll" />
		</ItemGroup>
		<Delete Files="@(StaleAssembly)" ContinueOnError="true" />
	</Target>

	<Target Name="ILRepack" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
		<ItemGroup>
			<InputAssemblies Include="$(TargetDir)WatchfulAnvil.Sdk.dll" />
		</ItemGroup>
		<ILRepack
			Parallel="true"
			Internalize="true"
			InputAssemblies="@(InputAssemblies)"
			MainAssembly="$(TargetDir)$(AssemblyName).dll"
			OutputFile="$(TargetDir)$(AssemblyName).dll"
			TargetKind="Dll"
			LibraryPath="$(TargetDir)"
		/>
	</Target>

	<ItemGroup>
		<PackageReference Include="UiPath.Activities.Api" Version="$(WatchfulAnvilApiVersion)">
			<ExcludeAssets>runtime</ExcludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

</Project>
