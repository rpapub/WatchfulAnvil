<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net461;net6.0;net8.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Minor bump: Info() and the IRegisterAnalyzerConfiguration placement are
         source-breaking, and annotation handling changed which violations are
         reported. See CHANGELOG.md. -->
    <Version>0.2.0-alpha</Version>
    <Authors>Christian Prior-Mamulyan</Authors>
    <Company>cprima.net</Company>
    <PackageDescription>Base classes and utilities for building UiPath Workflow Analyzer rules.</PackageDescription>

    <!-- Opt in to the shared build logic. Supplies the net461 stub target's
         LangVersion 7.3 / no-nullable / no-implicit-usings block and the per-TFM
         UiPath.Activities.Api version. See build/WatchfulAnvil.Build/. -->
    <WatchfulAnvilRulePack>true</WatchfulAnvilRulePack>
  </PropertyGroup>

  <!-- net461: only StubRule; exclude all modern Core and Diagnostics files -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <Compile Remove="Core\AnalyzerBase.cs" />
    <Compile Remove="Core\RuleBase.cs" />
    <Compile Remove="Core\CounterBase.cs" />
    <Compile Remove="Core\RuleCategory.cs" />
    <Compile Remove="Core\ScopedRule.cs" />
    <Compile Remove="Core\ActivityRule.cs" />
    <Compile Remove="Core\WorkflowRule.cs" />
    <Compile Remove="Core\ProjectRule.cs" />
    <Compile Remove="Core\SummaryRule.cs" />
    <Compile Remove="Common\AnnotationReader.cs" />
    <Compile Remove="Diagnostics\TapActivityRule.cs" />
    <Compile Remove="Diagnostics\TapWorkflowRule.cs" />
    <Compile Remove="Diagnostics\TapProjectRule.cs" />
    <Compile Remove="Diagnostics\TapSelectorsRule.cs" />
    <Compile Remove="Diagnostics\TapSdkBypassRule.cs" />
    <Compile Remove="Diagnostics\RunContext.cs" />
    <Compile Remove="Diagnostics\JsonlWriter.cs" />
    <Compile Remove="Diagnostics\ReflectionHelper.cs" />
    <Compile Remove="Common\ProjectJsonReader.cs" />
    <Compile Remove="Common\ProjectContext.cs" />
    <Compile Remove="Diagnostics\ActivityRecordBuilder.cs" />
    <Compile Remove="Diagnostics\WorkflowRecordBuilder.cs" />
  </ItemGroup>

  <!-- net6.0 / net8.0: exclude StubRule and StubRegistration (net461-only) -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net461'">
    <Compile Remove="Core\StubRule.cs" />
    <Compile Remove="Core\StubRegistration.cs" />
  </ItemGroup>

  <!-- Version resolved per TFM by WatchfulAnvil.Build.props -->
  <ItemGroup>
    <PackageReference Include="UiPath.Activities.Api" Version="$(WatchfulAnvilApiVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="content\analyzer-capabilities.yaml" Pack="true" PackagePath="content\" />
    <Content Include="content\rule-categories.json"       Pack="true" PackagePath="content\" />
    <Content Include="schemas\rule-category.schema.json"  Pack="true" PackagePath="schemas\" />
    <Content Include="schemas\rule.schema.json"            Pack="true" PackagePath="schemas\" />
    <Content Include="schemas\catalog.schema.json"         Pack="true" PackagePath="schemas\" />
    <Content Include="schemas\pack-manifest.schema.json"   Pack="true" PackagePath="schemas\" />
    <Content Include="schemas\rules.schema.json"            Pack="true" PackagePath="schemas\" />
  </ItemGroup>

</Project>
