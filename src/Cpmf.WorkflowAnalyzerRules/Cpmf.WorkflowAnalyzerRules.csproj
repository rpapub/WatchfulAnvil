<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net8.0</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<Version>0.1.0</Version>
		<FileVersion>0.1.0.0</FileVersion>
		<AssemblyVersion>0.1.0.0</AssemblyVersion>
		<InformationalVersion>0.1.0</InformationalVersion>
		<Authors>Christian Prior-Mamulyan</Authors>
		<Company>cprima.net</Company>
		<PackageDescription>Custom UiPath Workflow Analyzer rules by Christian Prior-Mamulyan.</PackageDescription>

		<!--
		  Not published. The curated dist/* packs are the release artefacts; this is the
		  source library they compile from. CI packs the solution with no project argument
		  and pushes everything it produces, so shipping this would publish an unintended
		  second copy of the same rules under a different id.

		  Still packable on demand, because the corpus harness and tools/analyze consume a
		  Cpmf.WorkflowAnalyzerRules nupkg from nupkg/. `just pack` passes the flag; CI
		  never sets it.
		-->
		<IsPackable Condition="'$(WatchfulAnvilPackDev)' == 'true'">true</IsPackable>
		<IsPackable Condition="'$(WatchfulAnvilPackDev)' != 'true'">false</IsPackable>

		<!-- Opt in to the shared build logic: per-TFM UiPath.Activities.Api version
		     and the net461 language block. See build/WatchfulAnvil.Build/. -->
		<WatchfulAnvilRulePack>true</WatchfulAnvilRulePack>
	</PropertyGroup>

	<!-- Plain reference, no PrivateAssets: the SDK must flow into the nuspec as a
	     dependency so the analyzer can resolve it. Measured to work in both uipcli
	     and Studio, which load it as a separate assembly. -->
	<ItemGroup>
		<ProjectReference Include="..\WatchfulAnvil.Sdk\WatchfulAnvil.Sdk.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="UiPath.Activities.Api" Version="$(WatchfulAnvilApiVersion)">
			<ExcludeAssets>runtime</ExcludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

</Project>
