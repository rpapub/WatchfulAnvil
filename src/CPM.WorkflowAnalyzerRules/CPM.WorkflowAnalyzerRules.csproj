<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net8.0</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<Version>0.1.0-alpha</Version>
		<FileVersion>0.1.0.0</FileVersion>
		<AssemblyVersion>0.1.0.0</AssemblyVersion>
		<InformationalVersion>0.1.0-alpha</InformationalVersion>
		<Authors>Christian Prior-Mamulyan</Authors>
		<Company>cprima.net</Company>
		<PackageDescription>Custom UiPath Workflow Analyzer rules by Christian Prior-Mamulyan.</PackageDescription>

		<!-- Not a release artefact; the curated dist/* packs are. -->
		<IsPackable>false</IsPackable>

		<!-- Opt in to the shared build logic: per-TFM UiPath.Activities.Api version
		     and the net461 language block. See build/WatchfulAnvil.Build/. -->
		<WatchfulAnvilRulePack>true</WatchfulAnvilRulePack>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\WatchfulAnvil.Sdk\WatchfulAnvil.Sdk.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="UiPath.Activities.Api" Version="$(WatchfulAnvilApiVersion)">
			<ExcludeAssets>runtime</ExcludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="LocalizationResources\Strings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Strings.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="LocalizationResources\Strings.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Strings.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

</Project>
