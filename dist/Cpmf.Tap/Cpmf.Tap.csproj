<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net461;net6.0;net8.0</TargetFrameworks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>Cpmf</RootNamespace>
    <AssemblyName>Cpmf.Tap</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>Cpmf</Authors>
    <PackageDescription>Cpmf TAP inspection rules — writes catalog-grade JSONL records to the WatchfulAnvil run directory.</PackageDescription>
    <IsPackable>true</IsPackable>

    <!-- Opt in to the shared build logic: per-TFM UiPath.Activities.Api version
         and the net461 language block. See build/WatchfulAnvil.Build/. -->
    <WatchfulAnvilRulePack>true</WatchfulAnvilRulePack>
  </PropertyGroup>

  <!-- This pack contains only the generated bootstrapper: the TAP rule classes live in
       WatchfulAnvil.Sdk.dll and now resolve from it at runtime rather than being merged
       in. Verified in the Phase 0 probe: an unmerged pack loads and its rules execute,
       and the SDK's own TAP rules do NOT auto-register in unrelated consumers. -->

  <!-- Generated bootstrapper: all targets -->
  <ItemGroup>
    <Compile Include="RegisterAnalyzerConfiguration.g.cs" />
  </ItemGroup>

  <!-- Plain reference, no PrivateAssets: the SDK must flow into the nuspec as a
       dependency so the analyzer can resolve it. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\WatchfulAnvil.Sdk\WatchfulAnvil.Sdk.csproj" />
  </ItemGroup>

  <!-- UiPath.Activities.Api -->
  <ItemGroup>
    <PackageReference Include="UiPath.Activities.Api" Version="$(WatchfulAnvilApiVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- R5: registry catalog(s) + manifest embedded in nupkg -->
  <ItemGroup>
    <Content Include="..\..\registry\CpmfTap\rules.yaml" Pack="true" PackagePath="content\" />
    <Content Include="manifest.json" Pack="true" PackagePath="content\" />
  </ItemGroup>

</Project>
