<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net461;net6.0;net8.0</TargetFrameworks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>Cpmf</RootNamespace>
    <AssemblyName>Cpmf.Community.Preview</AssemblyName>
    <Version>0.1.0-alpha</Version>
    <Authors>Cpmf</Authors>
    <PackageDescription>Community Preview — all available Cpmf rules. Updated with every library release.</PackageDescription>
    <IsPackable>true</IsPackable>

    <!-- Opt in to the shared build logic: per-TFM UiPath.Activities.Api version
         and the net461 language block. See build/WatchfulAnvil.Build/. -->
    <WatchfulAnvilRulePack>true</WatchfulAnvilRulePack>
  </PropertyGroup>

  <!-- Rule source files: net6.0 and net8.0 only -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net461'">
    <Compile Include="..\..\src\Cpmf.WorkflowAnalyzerRules\Rules\DotNetIdentifierValidator.cs" />
    <Compile Include="..\..\src\Cpmf.WorkflowAnalyzerRules\Rules\Workflow\LogMessageBookendsRule.cs" />
    <Compile Include="..\..\src\Cpmf.WorkflowAnalyzerRules\Rules\Workflow\UnitOutStatusRule.cs" />
    <Compile Include="..\..\src\Cpmf.WorkflowAnalyzerRules\Rules\Workflow\ModuleCodedConfigRule.cs" />
    <Compile Include="..\..\src\Cpmf.WorkflowAnalyzerRules\Rules\Workflow\NoFlowchartStateMachineRule.cs" />
    <Compile Include="..\..\src\Cpmf.WorkflowAnalyzerRules\Rules\Workflow\VariableNamingRule.cs" />
    <Compile Include="..\..\src\Cpmf.WorkflowAnalyzerRules\Rules\Workflow\SpecificContentAssignRule.cs" />
    <Compile Include="..\..\src\Cpmf.WorkflowAnalyzerRules\Rules\Workflow\WorkflowNameRule.cs" />
    <Compile Include="..\..\src\Cpmf.WorkflowAnalyzerRules\Rules\Workflow\StaleInvokeArgumentsRule.cs" />
    <Compile Include="..\..\src\Cpmf.WorkflowAnalyzerRules\Rules\Pipeline\PipelineSequenceOrderRule.cs" />
    <Compile Include="..\..\src\Cpmf.WorkflowAnalyzerRules\Rules\Pipeline\PipelineDomainModelRule.cs" />
    <Compile Include="..\..\src\Cpmf.WorkflowAnalyzerRules\Rules\Pipeline\ProjectNameRule.cs" />
    <Compile Include="..\..\src\Cpmf.WorkflowAnalyzerRules\Rules\Pipeline\PipelinePresenceCounter.cs" />
    <Compile Include="..\..\src\Cpmf.WorkflowAnalyzerRules\Rules\Pipeline\WorkflowTypeRatioRule.cs" />
  </ItemGroup>

  <!-- Generated bootstrapper: all targets -->
  <ItemGroup>
    <Compile Include="RegisterAnalyzerConfiguration.g.cs" />
  </ItemGroup>

  <!-- WatchfulAnvil.Sdk -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\WatchfulAnvil.Sdk\WatchfulAnvil.Sdk.csproj" />
  </ItemGroup>

  <!-- UiPath.Activities.Api -->
  <ItemGroup>
    <PackageReference Include="UiPath.Activities.Api" Version="$(WatchfulAnvilApiVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- R5: registry catalog(s) + manifest embedded in nupkg -->
  <ItemGroup>
    <Content Include="..\..\registry\Cpmf\rules.yaml" Pack="true" PackagePath="content\" />
    <Content Include="manifest.json" Pack="true" PackagePath="content\" />
  </ItemGroup>

</Project>
